<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TARUNA GRID V7.4 JUMBO"
        android:textColor="#FFA500"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="6dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/tv_rpm" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1"
            android:text="---" android:textColor="#00FF00" android:textSize="26sp" android:textStyle="bold"
            android:gravity="center" android:background="#222222" android:layout_margin="2dp"/>
        <TextView android:id="@+id/tv_map" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1"
            android:text="---" android:textColor="#00BFFF" android:textSize="18sp" android:textStyle="bold"
            android:gravity="center" android:background="#222222" android:layout_margin="2dp"/>
        <TextView android:id="@+id/tv_adv" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1"
            android:text="---" android:textColor="#FF00FF" android:textSize="18sp" android:textStyle="bold"
            android:gravity="center" android:background="#222222" android:layout_margin="2dp"/>
    </LinearLayout>

    <TextView android:id="@+id/tv_rowcol" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="LIVE..." android:textColor="#FFFF00" android:textSize="11sp" android:padding="4dp"/>
    <TextView android:id="@+id/tv_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="No USB" android:textColor="#00FF00" android:background="#111111" android:padding="2dp" android:textSize="10sp"/>
    <TextView android:id="@+id/tv" android:layout_width="match_parent" android:layout_height="50dp"
        android:text="Log..." android:textColor="#00FF00" android:background="#111111" android:textSize="9sp" android:padding="2dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btn_dtr" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:text="DTR OFF" android:textSize="10sp"/>
        <Button android:id="@+id/btn_rts" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:text="RTS OFF" android:textSize="10sp"/>
        <Button android:id="@+id/btn_connect" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:text="CONNECT" android:backgroundTint="#FFA500" android:textSize="10sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btn_getmap" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:text="GET MAP" android:backgroundTint="#888888" android:textSize="12sp" android:textStyle="bold"/>
        <Button android:id="@+id/btn_savemap" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:text="SAVE MAP" android:backgroundTint="#00FF00" android:textColor="#000000" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="GRID 16x16 - KLIK +1 / TAHAN -1 / KUNING=LIVE - GESER KANAN-KIRI ATAS-BAWAH"
        android:textColor="#FFA500" android:textSize="8sp" android:padding="2dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <GridLayout android:id="@+id/grid_map"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="17"
                android:rowCount="17"/>

        </HorizontalScrollView>
    </ScrollView>

</LinearLayout>
